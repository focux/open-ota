{
  "name": "open-ota",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Expo Updates server and dashboard on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev alchemy.run.ts",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "cloud:dev": "alchemy dev alchemy.run.ts",
    "cloud:plan": "alchemy plan alchemy.run.ts",
    "cloud:deploy": "alchemy deploy alchemy.run.ts",
    "cloud:deploy:prod": "alchemy deploy alchemy.run.ts --stage production",
    "cloud:destroy": "alchemy destroy alchemy.run.ts",
    "cloud:login": "alchemy login --configure alchemy.run.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.76",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
