# Secrets bound to the Worker
OTA_PUBLISH_TOKEN=
# PEM private key, PKCS#1 or PKCS#8, newlines escaped as \n inside the quotes
OTA_SIGNING_KEY=""

# Deploy-time settings. Leave the domains empty to use workers.dev URLs.
OTA_UPDATES_DOMAIN=updates.example.com
OTA_DASHBOARD_DOMAIN=ota.example.com
# Who may open the dashboard (Cloudflare Access). Required on every stage except dev_<user>.
OTA_ACCESS_EMAIL_DOMAINS=example.com
OTA_ACCESS_EMAILS=

# Everything below is optional. The values shown are the defaults.

# Delta patches. A patch is stored only when it is at most this share of the
# compressed bundle download, and only for bundles the Worker can verify in memory.
# OTA_PATCH_MAX_RATIO=0.3
# OTA_PATCH_MAX_BUNDLE_MB=32

# Retention. The nightly sweep keeps the newest groups per branch, anything
# younger than the day window, anything a device reported within the device
# window, active rollouts, and registered embedded bundles.
# OTA_RETAIN_GROUPS=20
# OTA_RETAIN_DAYS=30
# OTA_RETAIN_DEVICE_DAYS=90

# The dashboard's download counts read Analytics Engine through an API token
# the deploy mints, scoped to analytics only. Set to off when deploying with a
# credential that cannot create account tokens.
# OTA_DELIVERY_STATS=on
